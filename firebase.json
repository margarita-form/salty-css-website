{
  "hosting": {
    "public": "out",
    "site": "salty-css",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "trailingSlash": "true",
    "redirects": [
      {
        "source": "/docs",
        "destination": "/docs/react/",
        "type": 301
      },
      {
        "source": "/docs/",
        "destination": "/docs/react/",
        "type": 301
      },
      {
        "source": "/docs/quick-start/",
        "destination": "/docs/react/quick-start/",
        "type": 301
      },
      {
        "source": "/docs/installation/",
        "destination": "/docs/react/installation/",
        "type": 301
      },
      {
        "source": "/docs/usage/",
        "destination": "/docs/react/usage/",
        "type": 301
      },
      {
        "source": "/docs/faq/",
        "destination": "/docs/react/faq/",
        "type": 301
      },
      {
        "source": "/docs/cli/",
        "destination": "/docs/react/cli/",
        "type": 301
      },
      {
        "source": "/docs/basics/",
        "destination": "/docs/react/basics/",
        "type": 301
      },
      {
        "source": "/docs/variants/",
        "destination": "/docs/react/variants/",
        "type": 301
      },
      {
        "source": "/docs/classnames/",
        "destination": "/docs/react/classnames/",
        "type": 301
      },
      {
        "source": "/docs/overrides/",
        "destination": "/docs/react/overrides/",
        "type": 301
      },
      {
        "source": "/docs/animations/",
        "destination": "/docs/react/animations/",
        "type": 301
      },
      {
        "source": "/docs/color-function/",
        "destination": "/docs/react/color-function/",
        "type": 301
      },
      {
        "source": "/docs/templates/",
        "destination": "/docs/react/templates/",
        "type": 301
      },
      {
        "source": "/docs/media-queries/",
        "destination": "/docs/react/media-queries/",
        "type": 301
      },
      {
        "source": "/docs/viewport-clamp/",
        "destination": "/docs/react/viewport-clamp/",
        "type": 301
      },
      {
        "source": "/docs/api/styled/",
        "destination": "/docs/react/api/styled/",
        "type": 301
      },
      {
        "source": "/docs/api/classname/",
        "destination": "/docs/react/api/classname/",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/robots.txt",
        "destination": "/robots.txt"
      },
      {
        "source": "/sitemap.xml",
        "destination": "/sitemap.xml"
      },
      {
        "source": "/assets/**",
        "destination": "/assets/**"
      }
    ],
    "headers": [
      {
        "source": "**/_next/static/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      {
        "source": "**/*.@(js|css|woff2|woff|ttf|otf)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      {
        "source": "/icons/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, s-maxage=31536000" }]
      },
      {
        "source": "/assets/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, s-maxage=31536000" }]
      },
      {
        "source": "/favicon.png",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, s-maxage=31536000" }]
      },
      {
        "source": "/@(robots.txt|sitemap.xml|llms.txt)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, s-maxage=31536000" }]
      },
      {
        "source": "**/*.html",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, s-maxage=31536000, must-revalidate" }]
      }
    ]
  }
}
